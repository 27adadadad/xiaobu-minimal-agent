+
+@pytest.mark.asyncio
+async def test_bad_summary_keeps_previous_snapshot(store):
+    populate(store)
+    c=ContextManager(store,SummaryLLM());await c.prepare("A","1","x"); before=c.saved("A","1")
+    for i in range(16,25):
+        store.start("A","1",str(i),"new")
