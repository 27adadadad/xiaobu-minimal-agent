# Copy to .env; enter your own credential locally. Never commit .env.
LLM_API_KEY=
# OpenAI-compatible base URL, WITHOUT /chat/completions
LLM_BASE_URL=https://api.openai.com/v1
# Set a tool-calling capable model available to your account.
LLM_MODEL=
LLM_TIMEOUT=45
AGENT_DB=data/agent.sqlite3
